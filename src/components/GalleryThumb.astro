---
const { color = '#2B3A55', accent = '#E8C93C', label = 'Exhibition stand at an event' } = Astro.props;
---

<div class="thumb">
  <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={label} preserveAspectRatio="xMidYMid slice" style="width:100%;height:100%;">
    <rect width="400" height="300" fill="#DADADA"/>
    <rect y="220" width="400" height="80" fill="#B8B8B8"/>
    <rect x="40" y="60" width="320" height="160" fill={color}/>
    <rect x="70" y="90" width="90" height="110" fill="#fff" opacity=".9"/>
    <rect x="180" y="90" width="70" height="50" fill={accent}/>
    <rect x="180" y="150" width="70" height="50" fill="#fff" opacity=".8"/>
    <circle cx="320" cy="130" r="26" fill="#fff" opacity=".9"/>
  </svg>
</div>
