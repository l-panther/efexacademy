---
const { variant = 'roller' } = Astro.props;
---

{variant === 'roller' && (
  <svg class="hero-art" viewBox="0 0 320 260" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Illustration of two roller banner stands">
    <g>
      <rect x="40" y="40" width="90" height="170" rx="4" fill="#1F2430"/>
      <rect x="46" y="46" width="78" height="120" fill="#fff"/>
      <rect x="52" y="52" width="66" height="14" fill="#2FB5A6"/>
      <rect x="52" y="70" width="66" height="60" fill="#E23B3B"/>
      <rect x="52" y="134" width="66" height="30" fill="#E8C93C"/>
      <rect x="70" y="200" width="30" height="10" fill="#8A8F99"/>
    </g>
    <g>
      <rect x="170" y="20" width="100" height="200" rx="4" fill="#7A1F3C"/>
      <rect x="177" y="27" width="86" height="150" fill="#F2C9D6"/>
      <rect x="185" y="150" width="70" height="8" fill="#7A1F3C"/>
      <rect x="185" y="164" width="55" height="8" fill="#7A1F3C"/>
      <rect x="185" y="178" width="60" height="8" fill="#7A1F3C"/>
      <circle cx="245" cy="120" r="18" fill="#fff"/>
      <rect x="205" y="220" width="30" height="10" fill="#5A5A5A"/>
    </g>
  </svg>
)}

{variant === 'banner-stand' && (
  <svg class="hero-art" viewBox="0 0 320 260" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Illustration of two fabric banner stands">
    <rect x="40" y="30" width="95" height="195" rx="6" fill="#EDEDED"/>
    <rect x="46" y="36" width="83" height="183" fill="#2B3A55"/>
    <rect x="170" y="30" width="95" height="195" rx="6" fill="#EDEDED"/>
    <rect x="176" y="36" width="83" height="183" fill="#3E8FB0"/>
    <rect x="80" y="222" width="20" height="12" fill="#8A8F99"/>
    <rect x="210" y="222" width="20" height="12" fill="#8A8F99"/>
  </svg>
)}

{variant === 'popup' && (
  <svg class="hero-art" viewBox="0 0 320 220" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Illustration of a curved pop-up display wall">
    <path d="M40 190 C40 60 280 60 280 190 Z" fill="#8B1E2B"/>
    <path d="M60 185 C60 80 260 80 260 185 Z" fill="#EDEDED"/>
    <rect x="90" y="110" width="60" height="40" fill="#2B3A55"/>
    <rect x="170" y="110" width="60" height="40" fill="#3E8FB0"/>
    <rect x="40" y="188" width="240" height="14" fill="#5A5A5A"/>
  </svg>
)}

{variant === 'literature' && (
  <svg class="hero-art" viewBox="0 0 320 260" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Illustration of a zigzag literature stand">
    <rect x="60" y="20" width="90" height="200" fill="#2B3A55"/>
    <g transform="translate(210,40)">
      <polygon points="0,0 60,0 45,30 0,30" fill="#E8C93C"/>
      <polygon points="5,32 55,32 45,62 15,62" fill="#7A1F3C"/>
      <polygon points="10,64 50,64 42,94 18,94" fill="#2FB5A6"/>
      <rect x="20" y="96" width="20" height="60" fill="#5A5A5A"/>
    </g>
    <circle cx="270" cy="205" r="16" fill="#fff" stroke="#242424" stroke-width="2"/>
    <text x="270" y="211" font-size="16" font-family="Poppins, sans-serif" font-weight="700" text-anchor="middle" fill="#242424">1</text>
  </svg>
)}

{variant === 'exhibition' && (
  <svg class="hero-art" viewBox="0 0 320 240" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Illustration of a modular exhibition booth">
    <polygon points="60,220 60,60 100,20 260,20 260,220" fill="#EDEDED"/>
    <rect x="60" y="60" width="40" height="160" fill="#2B3A55"/>
    <g fill="#8A8F99">
      <rect x="150" y="60" width="20" height="20"/><rect x="175" y="60" width="20" height="20"/><rect x="200" y="60" width="20" height="20"/>
      <rect x="150" y="85" width="20" height="20" fill="#E8C93C"/><rect x="175" y="85" width="20" height="20" fill="#E23B3B"/><rect x="200" y="85" width="20" height="20" fill="#2FB5A6"/>
      <rect x="150" y="110" width="70" height="70" fill="#fff"/>
    </g>
  </svg>
)}

{variant === 'modular' && (
  <svg class="hero-art" viewBox="0 0 320 240" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Illustration of a modular panel display">
    <polygon points="60,220 60,40 260,40 260,220 220,220 220,80 100,80 100,220" fill="#3A3A3A"/>
    <g fill="#8A8F99">
      <rect x="150" y="55" width="16" height="16"/><rect x="170" y="55" width="16" height="16" fill="#E8C93C"/>
      <rect x="150" y="75" width="16" height="16" fill="#E23B3B"/><rect x="170" y="75" width="16" height="16"/>
      <rect x="150" y="95" width="16" height="16" fill="#2FB5A6"/><rect x="170" y="95" width="16" height="16"/>
    </g>
  </svg>
)}

{variant === 'design' && (
  <svg class="hero-art" viewBox="0 0 320 260" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Illustration of blank display panels ready for a custom design">
    <rect x="60" y="30" width="80" height="200" rx="4" fill="#EDEDED"/>
    <rect x="180" y="50" width="80" height="180" rx="4" fill="#DADADA"/>
    <rect x="60" y="255" width="80" height="10" fill="#8A8F99"/>
    <rect x="180" y="255" width="80" height="10" fill="#8A8F99"/>
  </svg>
)}

{variant === 'print' && (
  <svg class="hero-art" viewBox="0 0 320 220" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Illustration of a large format printer producing a sign">
    <rect x="150" y="30" width="140" height="30" rx="4" fill="#3A3A3A"/>
    <rect x="140" y="55" width="30" height="60" fill="#5A5A5A"/>
    <rect x="150" y="90" width="110" height="110" fill="#fff" stroke="#DADADA" stroke-width="2"/>
    <circle cx="185" cy="120" r="14" fill="#E23B3B"/>
    <circle cx="185" cy="160" r="14" fill="#2B3A55"/>
    <rect x="215" y="112" width="35" height="6" fill="#8A8F99"/>
    <rect x="215" y="130" width="35" height="6" fill="#8A8F99"/>
    <polygon points="150,200 260,200 245,215 165,215" fill="#E23B3B"/>
  </svg>
)}

{variant === 'event' && (
  <svg class="hero-art" viewBox="0 0 320 240" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Illustration of an event sign and two chairs">
    <rect x="50" y="30" width="80" height="170" rx="4" fill="#EDEDED"/>
    <circle cx="90" cy="80" r="26" fill="#D8B48A"/>
    <rect x="60" y="150" width="60" height="50" fill="#8A8F99"/>
    <g fill="#C79A6B">
      <rect x="160" y="90" width="45" height="55" rx="4"/>
      <rect x="165" y="145" width="6" height="55"/><rect x="195" y="145" width="6" height="55"/>
      <rect x="230" y="90" width="45" height="55" rx="4"/>
      <rect x="235" y="145" width="6" height="55"/><rect x="265" y="145" width="6" height="55"/>
    </g>
  </svg>
)}
