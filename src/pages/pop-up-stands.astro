---
import { asset } from '../utils/paths';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pop-up Stands" active="pop-up-stands">
   <section class="page-hero">
    <div class="hero-grid">

      <div class="hero-content">
        <span class="hero-eyebrow">Popup Stands</span>

        <h1>Big <span>Impact</span>. Easy Setup</h1>

        <p>
          Professional pop-up stands for exhibitions, events and promotional spaces.
        </p>

        <div class="hero-actions">
          <a href="/contact" class="hero-btn">
            Get a Quote
            <i class="bi bi-arrow-right"></i>
          </a>
        </div>
      </div>

      <div class="hero-visual">
        <img
          src={asset('assets/images/4.popup/hero.png')}
          alt="Professional promotional banner stands"
        />
      </div>
    </div>
  </section>

  <div class="page-content">
    <section>
      <h2>Popup Stands</h2>
      <p>Pop-up Stands offer the ultimate in seamless modular display. All packed into one wheeled case that is easily and quickly assembled, offering a graphic area of up to 2m x 3m.</p>
      <p>Frames are available in a variety of sizes, either curved or flat. Two or more frames can be linked together to create anything from backdrops to complex &ldquo;Presentation Areas&rdquo;. We also supply spotlights, monitor screens, iPad fixings, and counters with graphic wraps.</p>
      <p>Our magnet-to-magnet systems ensure fast installation and easy graphic positioning.</p>
      <p><strong>Need help with your design?</strong> We provide an in-house design and artwork service.</p>
      <p>We supply: Abex, Brit, Eurostand, Neschen, Space, Skyline, and Ultima.</p>
    </section>

    <section class="row text-center image-content">
      <div class="col-sm-6">
        <img src={asset('assets/images/4.popup/image1.jpg" alt="Portable modular exhibition stand setup at a conference')} />
      </div>
      <div class="col-sm-6">
        <img src={asset('assets/images/4.popup/image2.jpg" alt="Brand event display stand with promotional materials')} />
      </div>
    </section>
  </div>
</Layout>
