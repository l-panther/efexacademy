---
import { asset } from '../utils/paths';
import Layout from '../layouts/Layout.astro';
import HeroArt from '../components/HeroArt.astro';
import GalleryThumb from '../components/GalleryThumb.astro';
---

<Layout title="Exhibition Stands" active="exhibition-stands">
  <section class="page-hero">
    <div class="hero-grid">

      <div class="hero-content">
        <span class="hero-eyebrow">Exhibition Stands</span>

        <h1>Make Your Brand Unmissable</h1>

        <p>
          Professional exhibition stands designed to attract, engage and impress.
        </p>

        <div class="hero-actions">
          <a href="/contact" class="hero-btn">
            Get a Quote
            <i class="bi bi-arrow-right"></i>
          </a>
        </div>
      </div>
      <div class="hero-visual">
        <img
          src={asset('assets/images/6.exhibition/hero.png')}
          alt="Professional promotional banner stands"
        />
      </div>
    </div>
  </section>

  <div class="page-content">
    <section>
      <h2>Modular Exhibition Stands</h2>
      <p>Our custom modular exhibition systems are fully scalable. They offer a re-useable presentation solution, creating everything from small workstations to large hospitality-inclusive exhibition stands.</p>
      <p>Custom modular exhibition stands can look like custom exhibits, but you can benefit from your investment time and time again. Modular stands are flexible enough to fit a variety of stand shapes and sizes.</p>
      <p>Design accents can be added with a range of display accessories and lighting options.</p>
      <ul class="check-list">
        <li>Workstations</li>
        <li>Counters</li>
        <li>Showcases</li>
        <li>Display Pods</li>
        <li>And many more options</li>
      </ul>
    </section>

    <section class="row text-center image-content">
      <div class="col-sm-6">
        <img src={asset('assets/images/6.exhibition/image1.jpg')} alt="Portable modular exhibition stand setup at a conference" />
      </div>
      <div class="col-sm-6">
        <img src={asset('assets/images/6.exhibition/image2.jpg')} alt="Brand event display stand with promotional materials" />
      </div>
    </section>
  </div>
</Layout>
