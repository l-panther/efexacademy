---
import Layout from '../layouts/Layout.astro';
import HeroArt from '../components/HeroArt.astro';
import GalleryThumb from '../components/GalleryThumb.astro';
---

<Layout title="Stand Design" active="stand-design">
  <section class="page-hero">
    <div class="hero-grid">

      <div class="hero-content">
        <span class="hero-eyebrow">Stand designs</span>

        <h1>Designed To Make An <span>Impact</span></h1>

        <p>
          Creative stand designs tailored to your brand, space and audience.
        </p>

        <div class="hero-actions">
          <a href="/contact" class="hero-btn">
            Get a Quote
            <i class="bi bi-arrow-right"></i>
          </a>
        </div>
      </div>

      <div class="hero-visual">
        <img
          src="/assets/images/8.stand-design/hero.png"
          alt="Professional promotional banner stands"
        />
      </div>
    </div>
  </section>

  <div class="page-content">
    <section>
      <h2>Stand Design</h2>
      <p>You know what you want to say; you&rsquo;ve booked your space and have no idea what to put in it, or how it should look. Contact us. Efexacademy can project manage the build working with show organisers to make sure your event runs smoothly.</p>
      <p>Following an initial briefing and design consultation, we&rsquo;ll work closely with you at all stages, supplying colour visuals, photo-real renderings and fully dimensioned cad elevations to ensure you have a great show.</p>
    </section>

    <section class="row text-center image-content">
      <div class="col-sm-6">
          <img src="/assets/images/8.stand-design/image1.jpg" alt="Portable modular exhibition stand setup at a conference" />
        </div>
        <div class="col-sm-6">
          <img src="/assets/images/8.stand-design/image2.jpg" alt="Brand event display stand with promotional materials" />
        </div>
    </section>
  </div>
</Layout>
