---
import { page, asset } from '../utils/paths';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Roller Banners" active="roller-banners">
  <section class="page-hero">
    <div class="hero-grid">

      <div class="hero-content">
        <span class="hero-eyebrow">Roller Banners</span>

        <h1>Bold <span>Displays</span> That Get Noticed</h1>

        <p>
          Professional roller banners for events, exhibitions and promotions.
        </p>

        <div class="hero-actions">
          <a href={page('contact/')} class="hero-btn">
            Get a Quote
            <i class="bi bi-arrow-right"></i>
          </a>
        </div>
      </div>

      <div class="hero-visual">
        <img
          src={asset('assets/images/2.roller-banners/hero.png')}
          alt="Advertising and promotional banner display"
        />
      </div>

    </div>
  </section>

  <div class="page-content">
    <section>
      <h2>Roller Banners</h2>
      <p><strong>Instant branding</strong>: Roll-up banners set up in seconds! Ideal for promotional messages and point-of-sale displays. Simply take the stand out of its bag and roll it up! The graphic then rolls back into the base for storage and protection, ready for instant presentations time after time.</p>
      <ul class="check-list">
        <li>Roll-up stands</li>
        <li>Widths of 800, 850, 1000, 1200, and 1500mm</li>
        <li>Custom heights available</li>
        <li>Economy to luxury finish</li>
        <li>Interchangeable graphic / Removable cassette</li>
        <li>Double-sided options</li>
      </ul>
    </section>

    <section class="row text-center image-content">
      <div class="col-12">
        <img src={asset('assets/images/2.roller-banners/image1.jpg')} alt="Portable modular exhibition stand setup at a conference" />
      </div>
    </section>
  </div>
</Layout>
