---
import { page, asset } from '../utils/paths';
import Layout from '../layouts/Layout.astro';

const testimonials = [
  { quote: "I would like to thank you for your superb help on the event at the British Museum. The Deputy Private Secretary to The Prince of Wales and the Duchess of Cornwall was singing the praises of IBLF and the event.", author: 'The Prince of Wales International Business Leaders Forum', stars: 5 },
  { quote: 'The stands arrived and they look excellent, thank you very much for turning it around so quickly. Much appreciated.', author: 'Tourism Ireland', stars: 5 },
  { quote: 'The stands look really nice, thank you. Even better than the other ones because they are a bit lower so we can put them anywhere in the office.', author: 'Visa Europe', stars: 3 },
  { quote: "Delighted, they look great. We have 10 of them standing up in our office- so not much room to move around! The best one we like is Seattle so far... and the HR brand one. They have all turned out so well. Thanks for everything.", author: 'Hyatt Hotels & Resorts', stars: 3 },
];
---

<Layout title="Home" active="home">
<section class="page-hero">
  <div class="hero-grid">

    <div class="hero-content">
      <span class="hero-eyebrow">Quality Print &amp; Display Solutions</span>

      <h1>The Home of <span>Adverting</span></h1>

      <p>
        Professional banners and displays for events, exhibitions and promotions.
      </p>

      <div class="hero-actions">
        <a href={page('contact/')} class="hero-btn">
          Get a Quote
          <i class="bi bi-arrow-right"></i>
        </a>
      </div>
    </div>

    <div class="hero-visual">
      <img
        src={asset('assets/images/1.index/hero.png')}
        alt="Advertising and promotional banner display"
      />
    </div>
  </div>
</section>

  <div class="page-content">
    <section>
     
      <h2>Who Are We?</h2>
      
      <p>
        With over 20 years of industry experience, we are a dedicated
        team specialising in exhibition displays and promotional
        solutions. We understand the importance of making a lasting
        impression, and we work closely with our clients to bring
        their ideas to life.
      </p>

      <p>
        From initial planning through to the finished display,
        we pride ourselves on delivering high-quality solutions
        on time, within budget, and to the highest standards.
        Our approach combines practical expertise, attention
        to detail, and a commitment to exceeding expectations.
      </p>

      <p>
        We are also agency-friendly, offering flexible solutions
        for businesses, event organisers, and creative agencies.
        Whether you need a display for a single event or a
        temporary exhibition stand, we aim to make the process
        straightforward, efficient, and stress-free.
      </p>

      <h2 class="mt-4 pt-4">What We Do?</h2>
      
      <p>
        We specialise in lightweight, portable, and modular
        exhibition stands designed to help businesses showcase
        their brands with confidence. Our versatile display
        solutions are suitable for a wide range of promotional
        activities, including exhibitions, trade shows,
        conferences, presentations, product launches,
        recruitment events, and brand promotions.
      </p>
    
      <p>
        Our modular display systems combine professional
        presentation with practicality. Designed for easy
        transportation, quick assembly, and flexible
        configurations, they provide an effective way to
        create engaging exhibition spaces without the
        complexity of traditional display structures.
      </p>
      
      <p>
        Whether you're promoting a new product, increasing
        brand awareness, or creating an inviting space for
        potential customers, our displays can be adapted
        to suit different environments and requirements.
        We focus on providing practical, visually appealing
        solutions that help your business stand out.
      </p>
     
      <div class="testimonial-panel">
        <h2 class="head mt-0 mb-1">Testimonials</h2>
        <div class="body">
          {testimonials.map((t) => (
            <div class="testimonial-item">
              <p class="mb-0">&ldquo;{t.quote}&rdquo;</p>
              <cite>{t.author}</cite>
              <div class="stars" aria-label={`${t.stars} out of 5 stars`}>{'★'.repeat(t.stars)}{'☆'.repeat(5 - t.stars)}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="row text-center image-content">
      <div class="col-sm-6">
        <img src={asset('assets/images/1.index/image1.jpg')} alt="Portable modular exhibition stand setup at a conference" />
      </div>
      <div class="col-sm-6">
        <img src={asset('assets/images/1.index/image2.jpg')} alt="Brand event display stand with promotional materials" />
      </div>
    </section>
  </div>
</Layout>
