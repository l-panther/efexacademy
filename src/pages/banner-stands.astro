---
import { asset } from '../utils/paths';
import Layout from '../layouts/Layout.astro';
import GalleryThumb from '../components/GalleryThumb.astro';
---

<Layout title="Banner Stands" active="banner-stands">
 <section class="page-hero">
  <div class="hero-grid">

    <div class="hero-content">
      <span class="hero-eyebrow">Banner Stands</span>

      <h1>Make your <span>brand</span> stand out</h1>

      <p>
        Versatile banner stands for exhibitions, events and promotional spaces.
      </p>

      <div class="hero-actions">
        <a href="/contact" class="hero-btn">
          Get a Quote
          <i class="bi bi-arrow-right"></i>
        </a>
      </div>
    </div>

    <div class="hero-visual">
      <img
        src={asset('assets/images/3.banner-stands/hero.png')}
        alt="Professional promotional banner stands"
      />
    </div>
  </div>
</section>


  <div class="page-content">
    <section>
      <h2>Banner Stands</h2>
      <p>Banner stands &mdash; <strong>a perfect solution</strong> giving you the option to change your message each time you put it up.</p>
      <p>Banner stands are available in many styles, heights, and widths. They can be double-sided, and some styles have the option of joining together to form a graphic wall.</p>
      <ul class="check-list">
        <li>Easy to assemble/dismantle</li>
        <li>Quick change graphic facility</li>
        <li>Double-sided display available</li>
        <li>Strong yet light construction</li>
        <li>Easily extended with add-on frames</li>
        <li>Dismantles into compact unit</li>
        <li>Interior and exterior banners available</li>
      </ul>
    </section>

    <section class="row image-content">
      <div class="col-sm-6">
        <img src={asset('assets/images/3.banner-stands/image1.jpg" alt="Portable modular exhibition stand setup at a conference')} />
      </div>
      <div class="col-sm-6">
        <img src={asset('assets/images/3.banner-stands/image2.jpg" alt="Brand event display stand with promotional materials')} />
      </div>
    </section>
  </div>
</Layout>
