---
import { page, asset } from '../utils/paths';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Literature Stands" active="literature-stands">
  <section class="page-hero">
    <div class="hero-grid">

      <div class="hero-content">
        <span class="hero-eyebrow">Literature Stands</span>

        <h1>Present Your <span>Message</span> in Style</h1>

        <p>
          Stylish literature stands for brochures, leaflets and promotional materials.
        </p>

        <div class="hero-actions">
          <a href={page('contact/')} class="hero-btn">
            Get a Quote
            <i class="bi bi-arrow-right"></i>
          </a>
        </div>
      </div>
      <div class="hero-visual">
        <img
          src={asset('assets/images/5.literature/hero.png')}
          alt="Professional promotional literature stands">
      </div>
    </div>
  </section>

  <div class="page-content">
   
    <section>
      <h2>Literature Stands</h2>
    
      <p>
        Present your brochures, catalogues, and promotional
        materials professionally with our range of
        <strong>portable literature stands and display
        solutions</strong>. Designed to combine practicality
        with attractive presentation, these versatile
        products are ideal for exhibitions, conferences,
        trade shows, reception areas, and retail environments.
      </p>
    
      <p>
        Whether you're distributing product information,
        showcasing marketing materials, or incorporating
        interactive digital content into your display,
        our literature stands provide a convenient way
        to keep information organised and easily accessible.
        With lightweight construction, compact storage,
        and straightforward setup, they are particularly
        suitable for businesses attending multiple events.
      </p>
    
      <h3>
        <span class="num-badge me-2">1</span>
        Flex Brochure Stand
      </h3>
    
      <ul class="spec-list">
        <li>Lightweight aluminium collapsible display stand</li>
        <li>Capacity for 6 x A4 portrait brochures</li>
        <li>Includes aluminium flight case for easy transportation</li>
        <li>Material: Aluminium / plastic</li>
        <li>Colour: Silver / acrylic</li>
        <li>Dimensions: 270 x 1470mm (W x H)</li>
        <li>Weight: 8kg</li>
      </ul>
    
      <h3>
        <span class="num-badge me-2">2</span>
        Zig Zag Table
      </h3>
    
      <ul class="spec-list">
        <li>Free-standing portable folding counter</li>
        <li>Powder-coated grey finish</li>
        <li>Capacity for 3 x A4 brochures</li>
        <li>Folds flat for convenient transportation and storage</li>
        <li>Optional hardcase available</li>
        <li>Deep 30mm pockets for secure brochure storage</li>
        <li>Quick assembly with no tools required</li>
      </ul>
    
      <h3>
        <span class="num-badge me-2">3</span>
        iPad Display Stand
      </h3>
    
      <ul class="spec-list">
        <li>Compatible with iPad 1, iPad 2, and iPad 3</li>
        <li>Integrated apertures for dock connections</li>
        <li>360&deg; enclosure rotation</li>
        <li>90&deg; tilt adjustment</li>
        <li>360&deg; swivel for flexible viewing positions</li>
        <li>Acrylic podium tops available</li>
        <li>Optional brochure holders</li>
        <li>Available finishes: Neon blue, green, red, or frost</li>
      </ul>
    
      <p>
        From traditional brochure displays to interactive
        presentation stands, our range offers practical
        solutions for keeping your promotional materials
        visible, organised, and within easy reach.
        These products can be used individually or
        incorporated into larger exhibition displays
        to create a coordinated and professional
        presentation.
      </p>
    
      <p>
        <strong>Need help choosing the right display?</strong>
        Contact Efexacademy to discuss your requirements
        and find a literature stand suited to your
        event, venue, or promotional needs.
      </p>
    </section>

    <section class="row image-content literature-art text-center">
      <div class="col-sm-6">
        <img src={asset('assets/images/5.literature/image1.png')} alt="Portable modular exhibition stand setup at a conference" />
      </div>
      <div class="col-sm-6">
        <img src={asset('assets/images/5.literature/image2.png')} alt="Brand event display stand with promotional materials" />
      </div>
    </section>
  </div>
</Layout>

<style>

/* Product specifications */
.spec-list {
  list-style: none;
  padding: 0;
  margin: 1rem 0 2rem;
}

.spec-list li {
  padding: 0.65rem 0;
  border-bottom: 1px solid #e5e7eb;
  line-height: 1.6;
}

.spec-list li:last-child {
  border-bottom: none;
}
</style>
