---
import { asset } from '../utils/paths';
import Layout from '../layouts/Layout.astro';
import HeroArt from '../components/HeroArt.astro';
import GalleryThumb from '../components/GalleryThumb.astro';
---

<Layout title="Literature Stands" active="literature-stands">
  <section class="page-hero">
    <div class="hero-grid">

      <div class="hero-content">
        <span class="hero-eyebrow">Literature Stands</span>

        <h1>Present Your Message in Style.</h1>

        <p>
          Stylish literature stands for brochures, leaflets and promotional materials.
        </p>

        <div class="hero-actions">
          <a href="/contact" class="hero-btn">
            Get a Quote
            <i class="bi bi-arrow-right"></i>
          </a>
        </div>
      </div>
      <div class="hero-visual">
        <img
          src={asset('assets/images/5.literature/hero.png')}
          alt="Professional promotional banner stands"
        />
      </div>
    </div>
  </section>

  <div class="page-content">
    <section>
      <h2>Literature Stands</h2>

      <h3><span class="num-badge me-2">1</span>Flex Brochure Stand</h3>
      <p>A4 light aluminium collapsible display stand for 6 x A4 portrait brochures.<br>
      Includes aluminium flight case for easy transportation.<br>
      Material: aluminium/plastic<br>
      Colour: silver/acrylic<br>
      Size: 270 x 1470mm (W x H)<br>
      Weight: 8kg</p>

      <h3><span class="num-badge me-2">2</span>Zig Zag Table</h3>
      <p>Free-standing portable folding counter.<br>
      Powder-coated grey finish.<br>
      3 x A4 capacity.<br>
      Folds flat for easy transport.<br>
      Hardcase option available.<br>
      Deep 30mm pockets for secure storage.<br>
      No tools required for assembly.</p>

      <h3><span class="num-badge me-2">3</span>iPad Display Stand</h3>
      <p>Holds iPad 1, iPad 2, and iPad 3 with apertures for dock connection.<br>
      Enclosure rotation 360&deg;, 90&deg; tilt, and 360&deg; swivel for flexible display options.<br>
      Acrylic podium tops and brochure holders available in neon blue, green, red, or frost finishes.</p>
    </section>

    <section class="row image-content literature-art text-center">
      <div class="col-sm-6">
        <img src={asset)'assets/images/5.literature/image1.png')} alt="Portable modular exhibition stand setup at a conference" />
      </div>
      <div class="col-sm-6">
        <img src={asset('assets/images/5.literature/image2.png')} alt="Brand event display stand with promotional materials" />
      </div>
    </section>
  </div>
</Layout>
