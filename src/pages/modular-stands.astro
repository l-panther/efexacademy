---
import Layout from '../layouts/Layout.astro';
import HeroArt from '../components/HeroArt.astro';
import GalleryThumb from '../components/GalleryThumb.astro';
---

<Layout title="Modular Stands" active="modular-stands">
  <section class="page-hero">
    <div class="hero-grid">

      <div class="hero-content">
        <span class="hero-eyebrow">Modular Stands</span>

        <h1>Built To Fit. Made To Impress.</h1>

        <p>
          Flexible modular stands designed to adapt to your space and your brand.
        </p>

        <div class="hero-actions">
          <a href="/contact" class="hero-btn">
            Get a Quote
            <i class="bi bi-arrow-right"></i>
          </a>
        </div>
      </div>
      <div class="hero-visual">
        <img
          src="/assets/images/7.lite-modular/hero.png"
          alt="Professional promotional banner stands"
        />
      </div>
    </div>
  </section>

  <div class="page-content">
    <section>
      <h2>Modular Stands</h2>
      <p>An easy self-build system with a custom look. Simply a panel and a donut joiner. Reconfigure time after time for different needs.</p>
      <p><strong>Features include:</strong></p>
      <ul class="check-list">
        <li>Stand-off graphics / text panels</li>
        <li>Integral graphics</li>
        <li>Shelving</li>
        <li>Work stations</li>
      </ul>
    </section>

    <section class="row text-center image-content">
      <div class="col-sm-6">
          <img src="/assets/images/7.lite-modular/image1.jpg" alt="Portable modular exhibition stand setup at a conference" />
        </div>
        <div class="col-sm-6">
          <img src="/assets/images/7.lite-modular/image2.jpg" alt="Brand event display stand with promotional materials" />
        </div>
    </section>
  </div>
</Layout>
