---
import { page, asset } from '../utils/paths';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Event Management" active="event-management">
  <section class="page-hero">
    <div class="hero-grid">

      <div class="hero-content">
        <span class="hero-eyebrow">Event management</span>

        <h1>Seamless <span>Events</span>. Lasting Impact</h1>

        <p>
          Professional event management designed to bring your ideas to life.
        </p>

        <div class="hero-actions">
          <a href={page('contact/')} class="hero-btn">
            Get a Quote
            <i class="bi bi-arrow-right"></i>
          </a>
        </div>
      </div>

      <div class="hero-visual">
        <img
          src={asset('assets/images/10.event-management/hero.png')}
          alt="Professional promotional banner stands"
        />
      </div>
    </div>
  </section>

  <div class="page-content">
    <section>
      <h2>Event Management</h2>
      <p>Let Efexacademy project manage your event for you whether it is a conference, launch event, internal or external presentation. We will provide you with your own project manager, who will be your single point of contact and will ensure that your event runs smoothly.</p>
      <p>Giving you time to concentrate on other projects.</p>
    </section>

     <section class="row image-content">
      <div class="col-sm-6">
        <img src={asset('assets/images/10.event-management/image1.jpg')} alt="Portable modular exhibition stand setup at a conference" />
      </div>
      <div class="col-sm-6">
        <img src={asset('assets/images/10.event-management/image2.jpg')} alt="Brand event display stand with promotional materials" />
      </div>
    </section>
  </div>
</Layout>
